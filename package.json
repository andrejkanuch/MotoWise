{
  "name": "motovault",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.20.2"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "generate": "turbo generate:types generate:schema generate:graphql",
    "db:start": "supabase start --exclude storage-api,imgproxy,logflare,vector",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "turbo generate:types",
    "check:i18n": "sh scripts/check-i18n.sh",
    "i18n:status": "pnpm --filter mobile i18n:status",
    "check:api-bans": "sh scripts/check-api-bans.sh",
    "check:router": "sh scripts/check-no-router-any.sh",
    "precheck": "pnpm check:api-bans && pnpm check:router && pnpm lint && pnpm typecheck && pnpm test",
    "precheck:push": "sh scripts/precheck-changed.sh",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.8.0",
    "typescript": "~5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@apollo/protobufjs",
      "@nestjs/core",
      "@parcel/watcher",
      "@sentry-internal/node-cpu-profiler",
      "@sentry/cli",
      "@swc/core",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "graphql": "^16.14.2",
      "lightningcss": "1.32.0",
      "protobufjs": ">=7.6.4",
      "shell-quote": ">=1.9.0"
    }
  },
  "version": "1.0.0",
  "dependencies": {
    "date-fns": "^4.4.0",
    "expo": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3"
  }
}
