{
  "name": "motovault",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "generate": "turbo generate:types generate:schema generate:graphql",
    "db:start": "supabase start --exclude storage-api,imgproxy,logflare,vector",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "turbo generate:types",
    "check:i18n": "sh scripts/check-i18n.sh",
    "i18n:status": "pnpm --filter mobile i18n:status",
    "check:api-bans": "sh scripts/check-api-bans.sh",
    "check:router": "sh scripts/check-no-router-any.sh",
    "check:arch": "tsx scripts/check-arch-boundaries.ts",
    "knip": "knip",
    "precheck": "pnpm check:api-bans && pnpm check:router && pnpm check:arch && pnpm lint && pnpm typecheck && pnpm test",
    "precheck:push": "sh scripts/precheck-changed.sh",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "knip": "^5.64.4",
    "ts-morph": "^27.0.0",
    "tsx": "^4.22.4",
    "turbo": "^2.10.0",
    "typescript": "~5.9.3"
  },
  "version": "1.0.0",
  "dependencies": {
    "date-fns": "^4.4.0",
    "expo": "~56.0.16",
    "react": "19.2.3",
    "react-native": "0.85.3"
  }
}
