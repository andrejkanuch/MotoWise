{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["CI", "NODE_ENV"],
  "globalDependencies": [".env", "tsconfig.json", "biome.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!README.md",
        "!**/*.test.ts",
        "!**/*.spec.ts",
        "next.config.*",
        "app.json"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "SUPABASE_URL",
        "SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_*",
        "EXPO_PUBLIC_*",
        "APPLE_TEAM_ID",
        "ANDROID_CERT_SHA256",
        "SENTRY_*",
        "MAPBOX_ACCESS_TOKEN"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "check": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.*", "jest.config.*"],
      "env": ["SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.*.json"]
    },
    "generate:schema": {
      "dependsOn": ["^build"],
      "outputs": ["schema.graphql"]
    },
    "generate:graphql": {
      "dependsOn": ["@motovault/api#generate:schema"],
      "outputs": ["src/generated/**"]
    },
    "generate:types": {
      "outputs": ["src/database.types.ts"]
    }
  }
}
