{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["supabase", "eas"],
  "ignoreWorkspaces": ["packages/tsconfig"],
  "ignore": ["docs/**", "infra/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["turbo", "tsx"]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/**/*.module.ts",
        "scripts/*.ts",
        "src/**/*.{test,spec}.ts",
        "vitest.config.ts",
        "vitest.e2e.config.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["scripts/*.ts", "src/**/*.{test,spec}.{ts,tsx}", "e2e/**/*.spec.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/mobile": {
      "entry": ["src/**/__tests__/**/*.{ts,tsx}", "src/**/*.{test,spec}.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/**/*.web.{ts,tsx}"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.{test,spec}.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/graphql": {
      "entry": ["src/index.ts"],
      "ignore": ["src/generated/**"]
    },
    "packages/types": {
      "entry": ["src/index.ts", "src/**/*.{test,spec}.ts"],
      "ignore": ["src/database.types.ts"]
    }
  }
}
