PORT=4000
NODE_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
SUPABASE_JWT_SECRET=your-local-jwt-secret
OPENAI_API_KEY=your_openai_api_key_here
# Onboarding AI insights (Vercel AI SDK). Provider chain: Gemini -> OpenAI -> static.
# Gemini is primary when its key is set; otherwise OpenAI (above) is used.
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
AI_INSIGHTS_ENABLED=true
AI_INSIGHTS_TIMEOUT_MS=12000
# AI_INSIGHTS_GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
GRAPHQL_PLAYGROUND=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AI_LIMIT=10

# RevenueCat — subscription management
REVENUECAT_SECRET_API_KEY=your-revenuecat-secret-api-key
REVENUECAT_WEBHOOK_SECRET=your-revenuecat-webhook-secret

# Resend — transactional emails
RESEND_API_KEY=your-resend-api-key

# Upstash Redis — circuit breaker + rate limiting (optional in dev)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Sentry — error tracking (required in production)
SENTRY_DSN=your-sentry-dsn

# Meta Conversions API — ad attribution (optional in dev)
META_DATASET_ID=your-meta-dataset-id
META_ACCESS_TOKEN=your-meta-system-access-token

# On-demand revalidation of the web app's explore/trip pages on publish/unpublish.
# Both must be set (and REVALIDATE_SECRET must match the web app's value) or
# revalidation no-ops. See web src/app/api/revalidate/route.ts.
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=your-shared-revalidate-secret
