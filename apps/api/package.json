{
  "name": "@motovault/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec tsx",
    "start": "node dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "generate:schema": "ts-node --transpile-only scripts/generate-schema.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.84",
    "@ai-sdk/openai": "^3.0.75",
    "@apollo/server": "^4.13.0",
    "@as-integrations/express5": "^1.1.2",
    "@motovault/types": "workspace:*",
    "@nestjs/apollo": "^13.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.0.0",
    "@react-pdf/renderer": "4.5.1",
    "@sentry/nestjs": "^10.43.0",
    "@sentry/profiling-node": "^10.43.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/react": "^19.2.17",
    "@upstash/redis": "^1.38.0",
    "ai": "^6.0.210",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "graphql-depth-limit": "^1.1.0",
    "graphql-type-json": "^0.3.2",
    "helmet": "^8.2.0",
    "jose": "^6.2.3",
    "openai": "^6.29.0",
    "react": "19.2.7",
    "reflect-metadata": "^0.2.0",
    "resend": "^4.8.0",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.9",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@motovault/tsconfig": "workspace:*",
    "@types/ws": "^8.5.12",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/graphql-type-json": "^0.3.5",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "~5.7.0",
    "vitest": "^4.1.8"
  }
}
