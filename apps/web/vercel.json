{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm build --filter=@motovault/web",
  "outputDirectory": ".next",
  "ignoreCommand": "cd ../.. && npx --yes turbo-ignore @motovault/web"
}
