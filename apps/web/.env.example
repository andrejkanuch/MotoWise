NEXT_PUBLIC_BASE_URL=https://motovault.app
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql

# IndexNow
INDEXNOW_KEY=
INDEXNOW_SECRET=

# Universal Links / App Links — served via /.well-known/ route handlers
# Required for iOS Universal Links and Android App Links verification.
# Must also be set on Vercel (Production + Preview + Development environments).
# APPLE_TEAM_ID: 10-char alphanumeric Apple Developer Team ID
#   — find it in Apple Developer Portal → Membership details, or eas.json submit.production.ios.appleTeamId
# ANDROID_CERT_SHA256: SHA-256 fingerprint of the Play App Signing key
#   — get via `eas credentials -p android` or Play Console → Setup → App integrity → App signing
#   — colons OK, case-insensitive, must match exactly what Play Console shows
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=

# Route Hero Images (MOT-160)
# Service-role key for Supabase Storage uploads (route-hero cache)
SUPABASE_SERVICE_ROLE_KEY=
# Static map tile provider: 'stadia' (default)
MAP_TILE_PROVIDER=stadia
# Stadia Maps API key (required for production)
STADIA_API_KEY=
