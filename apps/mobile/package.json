{
  "name": "@motovault/mobile",
  "private": true,
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test": "jest",
    "test:e2e": "sh scripts/run-maestro.sh",
    "test:e2e:onboarding": "sh scripts/run-onboarding-e2e.sh",
    "test:e2e:edit-task": "sh scripts/run-edit-maintenance-task-e2e.sh",
    "test:e2e:add-bike": "E2E_FLOW=add-bike.yaml E2E_EMAIL_PREFIX=e2e-add-bike sh scripts/run-onboarding-e2e.sh",
    "test:e2e:add-expense": "E2E_FLOW=add-expense.yaml E2E_EMAIL_PREFIX=e2e-add-expense sh scripts/run-onboarding-e2e.sh",
    "test:e2e:delete-expense": "E2E_FLOW=delete-expense.yaml E2E_EMAIL_PREFIX=e2e-delete-expense sh scripts/run-onboarding-e2e.sh",
    "test:e2e:delete-expense-long-press": "E2E_FLOW=delete-expense-long-press.yaml E2E_EMAIL_PREFIX=e2e-delete-lp sh scripts/run-onboarding-e2e.sh",
    "test:e2e:expense-detail": "E2E_FLOW=expense-detail.yaml E2E_EMAIL_PREFIX=e2e-expense-detail sh scripts/run-onboarding-e2e.sh",
    "test:e2e:expense-service-record": "E2E_FLOW=expense-service-record.yaml E2E_EMAIL_PREFIX=e2e-expense-svc sh scripts/run-onboarding-e2e.sh",
    "test:e2e:complete-task": "E2E_FLOW=complete-maintenance-task.yaml E2E_EMAIL_PREFIX=e2e-complete-task sh scripts/run-onboarding-e2e.sh",
    "test:e2e:log-past-work": "E2E_FLOW=log-past-work.yaml E2E_EMAIL_PREFIX=e2e-log-past-work sh scripts/run-onboarding-e2e.sh",
    "test:e2e:log-ride": "E2E_FLOW=log-ride.yaml E2E_EMAIL_PREFIX=e2e-log-ride sh scripts/run-onboarding-e2e.sh",
    "test:e2e:units-display": "E2E_FLOW=units-display-toggle.yaml E2E_EMAIL_PREFIX=e2e-units-display sh scripts/run-onboarding-e2e.sh",
    "typecheck": "tsc --noEmit",
    "i18n:status": "npx i18next-cli status --config ./i18next-toolkit.config.mjs",
    "i18n:hardcoded": "eslint \"src/**/*.{ts,tsx}\"",
    "clean:artifacts": "find . -maxdepth 1 \\( -name 'build-*.aab' -o -name 'build-*.ipa' \\) -mtime +7 -delete && rm -rf dist"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/ui": "^57.0.9",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@iternio/react-native-auto-play": "^0.5.3",
    "@motovault/design-system": "workspace:*",
    "@motovault/graphql": "workspace:*",
    "@motovault/types": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@rnmapbox/maps": "^10.3.5",
    "@sentry/react-native": "^8.22.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-query-persist-client": "^5.97.0",
    "date-fns": "^4.4.0",
    "expo": "~57.0.11",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "^57.0.2",
    "expo-build-properties": "^57.0.9",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-image": "^57.0.2",
    "expo-image-manipulator": "^57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "^57.0.1",
    "expo-linking": "~57.0.5",
    "expo-localization": "^57.0.1",
    "expo-location": "~57.0.8",
    "expo-media-library": "~57.0.3",
    "expo-network": "^57.0.1",
    "expo-notifications": "^57.0.9",
    "expo-print": "^57.0.1",
    "expo-quick-actions": "^6.0.1",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "^57.0.10",
    "expo-splash-screen": "^57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "^57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.8",
    "expo-tracking-transparency": "^57.0.1",
    "expo-updates": "~57.0.12",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "^57.0.8",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "i18next": "^25.10.10",
    "lucide-react-native": "^0.577.0",
    "nativewind": "5.0.0-preview.4",
    "posthog-react-native": "^4.47.2",
    "react": "19.2.3",
    "react-i18next": "^16.5.6",
    "react-native": "0.86.2",
    "react-native-blob-util": "^0.24.10",
    "react-native-css": "^3.0.7",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-keyboard-controller": "^1.21.9",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-pdf": "^7.0.4",
    "react-native-play-install-referrer": "1.1.9",
    "react-native-purchases": "10.4.2",
    "react-native-purchases-ui": "10.4.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    },
    "autolinking": {
      "android": {
        "exclude": [
          "@iternio/react-native-auto-play"
        ]
      }
    }
  },
  "devDependencies": {
    "@motovault/tsconfig": "workspace:*",
    "@react-native/jest-preset": "0.86.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/geojson": "7946.0.16",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "eslint-plugin-i18next": "^6.1.4",
    "i18next-cli": "^1.64.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3"
  }
}
