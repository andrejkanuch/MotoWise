# MotoVault mobile — example env. Copy to `.env` (dev) / `.env.production` (release)
# and fill with real values. This file must stay a SUPERSET of every key the app
# reads via `process.env` / `EXPO_PUBLIC_*` (grep `EXPO_PUBLIC_`/`process.env.` in
# `src` + `app.config.ts`). Placeholders only — never commit real secrets.

# --- Core API + Supabase ---
EXPO_PUBLIC_API_URL=http://localhost:4000/graphql
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Public web origin — used by share-ride deep links (share-ride-button.tsx)
EXPO_PUBLIC_WEB_URL=https://motovault.app

# --- Google Sign-In (@react-native-google-signin/google-signin) ---
# Both required for native Google auth; missing them breaks sign-in at runtime.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# --- RevenueCat ---
EXPO_PUBLIC_RC_IOS_KEY=your-revenuecat-ios-key
EXPO_PUBLIC_RC_ANDROID_KEY=your-revenuecat-android-key

# --- Mapbox ---
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=your-mapbox-public-token
MAPBOX_DOWNLOAD_TOKEN=your-mapbox-secret-token

# --- Sentry — crash reporting ---
SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# --- PostHog — product analytics ---
POSTHOG_API_KEY=your-posthog-api-key
POSTHOG_HOST=https://eu.i.posthog.com

# --- Meta / Facebook SDK ---
EXPO_PUBLIC_META_APP_ID=
EXPO_PUBLIC_META_CLIENT_TOKEN=

# --- Build variant (app.config.ts) ---
# Selects bundle id / app name. Values: development | preview | (unset = production)
# APP_VARIANT=development

# --- Onboarding A/B (DEV ONLY) — force an experiment arm in a __DEV__ build. ---
# PostHog is disabled in dev, so the onboarding_ab_2026 flag never evaluates and
# every run resolves to `control`. Set this to exercise lean/invested/control
# locally. Ignored in release builds. Values: lean | invested | control
# EXPO_PUBLIC_OB_VARIANT=invested
