{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.0"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "e2e-simulator": {
      "distribution": "internal",
      "environment": "production",
      "channel": "e2e",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.0"
      },
      "env": {
        "EXPO_PUBLIC_OB_VARIANT": "invested",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "kanuchandrej@gmail.com",
        "ascAppId": "6760291360",
        "appleTeamId": "Y4MW4DD2RQ"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}
