{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.0"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "EAS_NO_FROZEN_LOCKFILE": "1"
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.0"
      }
    },
    "e2e-simulator": {
      "distribution": "internal",
      "environment": "production",
      "channel": "e2e",
      "ios": {
        "simulator": true,
        "image": "macos-tahoe-26.6-xcode-27.0"
      },
      "env": {
        "EXPO_PUBLIC_OB_VARIANT": "invested",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "e2e",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_E2E_RUN": "1",
        "EAS_NO_FROZEN_LOCKFILE": "1"
      }
    },
    "e2e-android": {
      "distribution": "internal",
      "environment": "production",
      "channel": "e2e",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_OB_VARIANT": "invested",
        "EXPO_PUBLIC_E2E_RUN": "1",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "e2e",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "EXPO_PUBLIC_E2E_NO_VENDOR_SDKS": "1"
      }
    },
    "e2e-android-local": {
      "extends": "e2e-android",
      "env": {
        "E2E_LOCAL_STACK": "1",
        "EXPO_PUBLIC_SUPABASE_URL": "http://10.0.2.2:54321",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:4000/graphql",
        "EXPO_PUBLIC_OB_VARIANT": "invested",
        "EXPO_PUBLIC_E2E_RUN": "1",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "e2e",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "EXPO_PUBLIC_E2E_NO_VENDOR_SDKS": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "kanuchandrej@gmail.com",
        "ascAppId": "6760291360",
        "appleTeamId": "Y4MW4DD2RQ"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}
