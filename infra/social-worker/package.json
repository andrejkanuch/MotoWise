{
  "name": "@motovault/social-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that publishes MotoVault social media posts on a cron schedule",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "fill-queue": "tsx scripts/fill-queue.ts",
    "upload-screenshots": "tsx scripts/upload-screenshots.ts",
    "publish-carousel": "tsx --env-file=.env scripts/publish-carousel.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260625.1",
    "@types/node": "^25.9.4",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "wrangler": "^4.105.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.84",
    "@ai-sdk/openai": "^3.0.75",
    "ai": "^6.0.210",
    "zod": "^3.25.76"
  }
}
